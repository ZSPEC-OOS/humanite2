# Copy to .env.local and fill in values — never commit .env.local

# ── Required ──────────────────────────────────────────────────────────────────

# Firebase / Firestore
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OpenAI — or any OpenAI-compatible provider
OPENAI_API_KEY=sk-...

# JWT secret — any long random string, e.g.: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# ── Optional ──────────────────────────────────────────────────────────────────

# OPENAI_BASE_URL=https://api.openai.com/v1   # override for other providers
# OPENAI_MODEL=gpt-4o-mini                    # default: gpt-4o-mini

# AI detection (Sapling, or GPTZero) — never receives OPENAI_API_KEY or any
# generation-model config; detection must not depend on, or be gradeable
# by, whatever produced the text. Unset DETECTION_PROVIDER (or anything
# other than "sapling"/"gptzero") runs against a built-in mock provider
# instead, so local dev and CI never spend a real detection-provider request.
# SAPLING_API_KEY=
# GPTZERO_API_KEY=
# DETECTION_PROVIDER=sapling                  # unset = mock; "sapling" or "gptzero"
# ALLOW_MOCK_DETECTION=true                    # required to run the mock provider when NODE_ENV=production — otherwise a production deployment without DETECTION_PROVIDER set fails closed instead of serving fake results
# DETECTION_TIMEOUT_MS=30000                  # default: 30000
# MOCK_DETECTION_FIXTURE=human                # mock only: human | ai | mixed | low-confidence | timeout | rate-limit | invalid-response
# LOCAL_DIAGNOSTICS_ENABLED=true               # default: true — descriptive writing stats attached alongside every detection result, never fed back into the classification itself
# SCAN_CACHE_TTL_SECONDS=86400                 # default: 86400 (24h) — identical text (+ same provider) reuses the cached scan result instead of a new GPTZero request
# WATERMARK_SECRET_SALT=replace-with-random-base64

# Daily usage quotas per authenticated user, protecting this deployment's own
# OPENAI_API_KEY/detection-provider key from runaway use — never applied when
# the caller supplies their own key (api_config.api_key / gptzero_api_key).
# Generation and scan are separate pools (AI-detection scanning runs far more
# per word than generation, so metering them independently matters even
# though every tier now includes both). Numbers below are each tier's
# advertised monthly word quota (50,000 / 100,000 / 150,000, equal for
# generation and scanning) divided by 30. A pool's requests/words set to 0
# means that plan doesn't include the feature at all — see usageLimits.ts.
# FREE_TIER_GENERATION_REQUESTS_PER_DAY=100
# FREE_TIER_GENERATION_WORDS_PER_DAY=1667
# FREE_TIER_SCAN_REQUESTS_PER_DAY=20
# FREE_TIER_SCAN_WORDS_PER_DAY=1667
# PRO_TIER_GENERATION_REQUESTS_PER_DAY=150
# PRO_TIER_GENERATION_WORDS_PER_DAY=3333
# PRO_TIER_SCAN_REQUESTS_PER_DAY=40
# PRO_TIER_SCAN_WORDS_PER_DAY=3333
# ENTERPRISE_TIER_GENERATION_REQUESTS_PER_DAY=300
# ENTERPRISE_TIER_GENERATION_WORDS_PER_DAY=5000
# ENTERPRISE_TIER_SCAN_REQUESTS_PER_DAY=60
# ENTERPRISE_TIER_SCAN_WORDS_PER_DAY=5000

# Comma-separated sha256(email) hashes that bypass both quotas above
# entirely (no request/word cap, generation or scan), regardless of tier —
# an operator allowlist, not a pricing tier. Compute with:
#   node -e "console.log(require('crypto').createHash('sha256').update('you@example.com').digest('hex'))"
# UNLIMITED_USAGE_EMAIL_HASHES=8a9c962fd4bea9a63a4cc4c8497f151a88386c30a3f6bfbcad6743cbb017a2c4
# NEXT_PUBLIC_APP_URL=https://your-deployed-domain.example  # used to build working watermark verification links

# Cloudflare R2 — syncs the "AI Model Config" (nickname/model/base URL/API
# key) across devices instead of leaving it in this browser's localStorage
# only. Omit any of these three and sync silently no-ops (each device keeps
# its own local-only config, same as before).
# Create a bucket + API token: Cloudflare dashboard → R2 → Manage R2 API Tokens
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET_NAME=your-bucket-name
# CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-string   # encrypts the API key at rest in R2; falls back to JWT_SECRET if unset

# Stripe — powers the /pricing page's paid-tier checkout
# (src/app/api/v1/billing/checkout). Omit and the "Upgrade to Pro" button
# shows a clear "payments not configured" error instead of crashing.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID_PRO=price_...                # Price ID for the Pro tier (src/lib/pricing.ts)
# STRIPE_WEBHOOK_SECRET=whsec_...              # from the Stripe dashboard once the webhook endpoint below is registered
# Webhook endpoint to register in the Stripe dashboard: <your-domain>/api/v1/billing/webhook
